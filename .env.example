# Postgres connection string (Neon via the Vercel integration sets this). Leave unset locally to use in-process PGlite.
DATABASE_URL=
# Optional: signing secret for session tokens. If unset, the app generates one and stores it in the database.
AUTH_SECRET=
# AI: "replay" (fixtures only, used on previews and in tests) or "live" (fixtures first, then the model).
AI_MODE=replay
OPENROUTER_API_KEY=
AI_MODEL=deepseek/deepseek-v4-flash
